{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "$(ls ~/.config/fastfetch/images/*.png | shuf -n 1)"
    },
    "display": {
        "separator": " "
    },
    "modules": [
        "host",
        "os",
        "kernel",
        "packages",
        "shell",
        "terminal",
        "cpu",
        "gpu",
        "memory"
    ]
}
